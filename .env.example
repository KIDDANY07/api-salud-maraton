NODE_ENV=development
PORT=3000
URL_DB=postgres://rural:rural_demo_password@localhost:5433/rural_routes
TEST_URL_DB=postgres://rural:rural_demo_password@localhost:5433/rural_routes_e2e
ROAD_FACTOR=1.3
VEREDAS_DATA_PATH=data/veredas.json
OAUTH_ISSUER=http://localhost:8080/realms/rural-health
OAUTH_AUDIENCE=rural-routes-api
OAUTH_JWKS_URI=http://localhost:8080/realms/rural-health/protocol/openid-connect/certs
OAUTH_TOKEN_URL=http://localhost:8080/realms/rural-health/protocol/openid-connect/token
OAUTH_AUTHORIZATION_URL=http://localhost:8080/realms/rural-health/protocol/openid-connect/auth
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=rural-health
KEYCLOAK_TIMEOUT_MS=5000
LOGIN_CLIENT_ID=rural-routes-web
KEYCLOAK_ADMIN_CLIENT_ID=rural-routes-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=admin-api-demo-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
SELF_REGISTRATION_ENABLED=true
LOG_LEVEL=info
SWAGGER_ENABLED=true
POSTGRES_USER=rural
POSTGRES_PASSWORD=rural_demo_password
POSTGRES_DB=rural_routes
POSTGRES_HOST_PORT=5433
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_demo_password
PLANIFICADOR_CLIENT_ID=planificador-app
PLANIFICADOR_CLIENT_SECRET=planificador-demo-secret
AUDITOR_CLIENT_ID=auditor-app
AUDITOR_CLIENT_SECRET=auditor-demo-secret
