{
  "realm": "rural-health",
  "displayName": "Salud Rural Cundinamarca (demo)",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "clientScopes": [
    {
      "name": "routes:read",
      "description": "Consultar rutas sugeridas y el catálogo de veredas",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "routes:write",
      "description": "Generar rutas sugeridas",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "audit:read",
      "description": "Consultar la auditoría y el desglose del cálculo",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "defaultDefaultClientScopes": [],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "planificador-app",
      "name": "Planificador de rutas",
      "description": "Cliente de demostración con Client Credentials",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "planificador-demo-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "webOrigins": [
        "http://localhost:3000"
      ],
      "redirectUris": [],
      "attributes": {
        "access.token.lifespan": "300",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "routes:read",
        "routes:write"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-rural-routes-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rural-routes-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "auditor-app",
      "name": "Auditor de rutas",
      "description": "Cliente de demostración con Client Credentials",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "auditor-demo-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "webOrigins": [
        "http://localhost:3000"
      ],
      "redirectUris": [],
      "attributes": {
        "access.token.lifespan": "300",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "routes:read",
        "audit:read"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-rural-routes-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rural-routes-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-planificador-app",
      "enabled": true,
      "serviceAccountClientId": "planificador-app"
    },
    {
      "username": "service-account-auditor-app",
      "enabled": true,
      "serviceAccountClientId": "auditor-app"
    }
  ]
}
