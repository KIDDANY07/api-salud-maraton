@baseUrl = http://localhost:3000/api/v1
@tokenUrl = http://localhost:8080/realms/rural-health/protocol/openid-connect/token
@adminToken = PEGAR_ACCESS_TOKEN_DE_ADMIN_DEMO
@coordinatorToken = PEGAR_ACCESS_TOKEN_DE_COORDINADOR_DEMO
@auditorToken = PEGAR_ACCESS_TOKEN_DE_AUDITOR_DEMO
@teamToken = PEGAR_ACCESS_TOKEN_DE_EQUIPO_DEMO
@refreshToken = PEGAR_REFRESH_TOKEN
@routeId = PEGAR_ROUTE_ID_GENERADO
@userId = PEGAR_ID_DE_USUARIO

